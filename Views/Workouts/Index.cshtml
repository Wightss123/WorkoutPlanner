@model IEnumerable<WorkoutPlanner.Models.Workout>

@{
    ViewData["Title"] = "Тренування";
}

<div class="container mt-5 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold text-gradient">Тренування</h1>
        <a asp-action="Create" class="btn btn-primary btn-glow rounded-pill px-4 py-2">
            <i class="bi bi-plus-lg me-2"></i>Створити тренування
        </a>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-auto">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control bg-dark text-light border-secondary" placeholder="Пошук за назвою..." style="min-width: 250px;">
            </div>
            <div class="col-auto">
                <select name="workoutType" class="form-select bg-dark text-light border-secondary" style="min-width: 200px;" onchange="this.form.submit()">
                    <option value="">Всі типи тренувань</option>
                    @if (ViewData["CurrentType"]?.ToString() == "Cardio") { <option value="Cardio" selected>Кардіо</option> } else { <option value="Cardio">Кардіо</option> }
                    @if (ViewData["CurrentType"]?.ToString() == "Strength") { <option value="Strength" selected>Силове</option> } else { <option value="Strength">Силове</option> }
                    @if (ViewData["CurrentType"]?.ToString() == "Flexibility") { <option value="Flexibility" selected>Гнучкість</option> } else { <option value="Flexibility">Гнучкість</option> }
                    @if (ViewData["CurrentType"]?.ToString() == "Interval") { <option value="Interval" selected>Інтервальне</option> } else { <option value="Interval">Інтервальне</option> }
                </select>
            </div>

            @if (ViewData["CurrentFilter"] != null || ViewData["CurrentType"] != null)
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">Очистити</a>
                </div>
            }
        </div>
    </form>

    <div class="table-responsive glass-card p-4 rounded-4">
        <table class="table table-dark table-hover table-borderless align-middle mb-0">
            <thead>
                <tr class="text-uppercase text-muted small border-bottom border-secondary">
                    <th>Назва</th>
                    <th>Тип</th>
                    <th>Інтенсивність</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td class="fw-bold">@item.Name</td>
                        <td>
                            @if(item.WorkoutType == "Cardio") { <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-heart-pulse me-1"></i>Кардіо</span> }
                            else if(item.WorkoutType == "Strength") { <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="bi bi-lightning-charge me-1"></i>Силове</span> }
                            else if(item.WorkoutType == "Interval") { <span class="badge bg-info text-dark rounded-pill px-3 py-2"><i class="bi bi-stopwatch me-1"></i>Інтервальне</span> }
                            else { <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-activity me-1"></i>Гнучкість</span> }
                        </td>
                        <td>
                            <span class="text-muted">
                                @if(item.MetValue <= 3.0) { <text>Легке</text> }
                                else if(item.MetValue <= 6.0) { <text>Середнє</text> }
                                else if(item.MetValue <= 8.0) { <text>Високе</text> }
                                else { <text>Екстремальне</text> }
                                (@item.MetValue MET)
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill px-3">Деталі</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Видалити</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
