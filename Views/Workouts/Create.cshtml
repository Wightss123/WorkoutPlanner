@model WorkoutPlanner.Models.Workout

@{
    ViewData["Title"] = "Створити тренування";
}

<div class="container mt-5 fade-in">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card glass-card shadow-lg border-0" style="border-radius: 1rem;">
                <div class="card-body p-4 p-md-5">
                    <h3 class="fw-bold text-white text-center mb-4">Нове тренування (Довідник)</h3>
                    
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-4">
                            <h5 class="text-white mb-3" style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;">Основна інформація</h5>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-5 text-start">
                                <label asp-for="Name" class="form-label text-muted fw-bold mb-1">Назва тренування</label>
                                <input asp-for="Name" class="form-control bg-dark text-light border-secondary" placeholder="Наприклад: Жим лежачи" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3 text-start">
                                <label asp-for="WorkoutType" class="form-label text-muted fw-bold mb-1">Тип</label>
                                <select asp-for="WorkoutType" id="WorkoutType" class="form-select bg-dark text-light border-secondary">
                                    <option value="Cardio">Кардіо</option>
                                    <option value="Strength">Силове</option>
                                    <option value="Flexibility">Гнучкість</option>
                                    <option value="Interval">Інтервальне/Серійне</option>
                                </select>
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="MetValue" class="form-label text-muted fw-bold mb-1">Інтенсивність</label>
                                <select asp-for="MetValue" id="MetValue" class="form-select bg-dark text-light border-secondary">
                                    <option value="2.5">Легке навантаження</option>
                                    <option value="5.0">Середнє навантаження</option>
                                    <option value="8.0">Високе навантаження</option>
                                    <option value="10.0">Екстремальне навантаження</option>
                                </select>
                            </div>
                        </div>

                        <div class="mt-4 text-start">
                            <label asp-for="Notes" class="form-label text-muted fw-bold mb-1">Опис тренування</label>
                            <textarea asp-for="Notes" class="form-control bg-dark text-light border-secondary" style="height: 100px" placeholder="Короткий опис, на які м'язи розраховано тощо" required></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-5">
                            <button type="submit" class="btn btn-primary btn-glow rounded-pill py-2 fw-bold">Зберегти у довідник</button>
                            <button type="button" onclick="history.back()" class="btn btn-outline-light rounded-pill py-2">Скасувати</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const workoutType = document.getElementById('WorkoutType');
            const metValue = document.getElementById('MetValue');

            workoutType.addEventListener('change', function() {
                const type = this.value;
                if (type === 'Flexibility') {
                    metValue.value = '2.5';
                } else if (type === 'Strength') {
                    metValue.value = '5.0';
                } else if (type === 'Cardio') {
                    metValue.value = '8.0';
                } else if (type === 'Interval') {
                    metValue.value = '10.0';
                }
            });
        });
    </script>
}
