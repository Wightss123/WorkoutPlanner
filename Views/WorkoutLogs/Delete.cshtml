@model WorkoutPlanner.Models.WorkoutLog

@{
    ViewData["Title"] = "Видалити запис журналу";
}

<div>
    <div>
        <div>
            <h2>Ви впевнені, що хочете видалити цей запис?</h2>
            <h4>@Model.User?.FullName</h4>
            <h5>@Model.Workout?.Name - @Model.CompletedDate.ToShortDateString()</h5>
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit">Так, видалити</button>
                <a asp-action="Index">Ні, повернутися</a>
            </form>
        </div>
    </div>
</div>
