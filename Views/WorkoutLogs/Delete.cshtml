@model WorkoutPlanner.Models.WorkoutLog

@{
    ViewData["Title"] = "Видалити запис журналу";
}

<div class="container mt-5 fade-in">
    <div class="card glass-card border-danger">
        <div class="card-body p-5 text-center">
            <h2 class="text-danger fw-bold mb-4">Ви впевнені, що хочете видалити цей запис?</h2>
            <h4 class="mb-3">@Model.User?.FullName</h4>
            <h5 class="text-muted">@Model.Workout?.Name - @Model.CompletedDate.ToShortDateString()</h5>
            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger btn-glow rounded-pill px-5 py-2 me-2">Так, видалити</button>
                <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2">Ні, повернутися</a>
            </form>
        </div>
    </div>
</div>
