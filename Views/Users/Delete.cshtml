@model WorkoutPlanner.Models.User

@{
    ViewData["Title"] = "Видалити клієнта";
}

<div>
    <div>
        <div>
            <h2>Ви впевнені, що хочете видалити цього клієнта?</h2>
            <h4>@Model.FullName</h4>
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit">Так, видалити</button>
                <a asp-action="Index">Ні, повернутися</a>
            </form>
        </div>
    </div>
</div>
