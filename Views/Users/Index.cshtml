@model IEnumerable<WorkoutPlanner.Models.User>

@{
    ViewData["Title"] = "Клієнти";
    var currentSort = ViewData["CurrentSort"]?.ToString();
}

<div class="container mt-5 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold text-gradient">Клієнти</h1>
        <div>
            <a asp-action="ExportToFile" class="btn btn-outline-success rounded-pill px-4 py-2 me-2">
                <i class="bi bi-download me-2"></i>Експорт у файл
            </a>
            <a asp-action="Create" class="btn btn-primary btn-glow rounded-pill px-4 py-2">
                <i class="bi bi-person-plus-fill me-2"></i>Додати клієнта
            </a>
        </div>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
        <div class="input-group" style="max-width: 400px;">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control bg-dark text-light border-secondary" placeholder="Пошук за ім'ям або метою...">
            <button class="btn btn-info text-dark fw-bold" type="submit"><i class="bi bi-search"></i> Знайти</button>
            @if (ViewData["CurrentFilter"] != null)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Очистити</a>
            }
        </div>
    </form>

    <!-- Кнопки сортування -->
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
        <span class="text-muted me-2"><i class="bi bi-sort-alpha-down me-1"></i>Сортувати:</span>
        <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSort"]" asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-sm @(currentSort == "name_asc" || currentSort == "name_desc" ? "btn-info text-dark" : "btn-outline-secondary") rounded-pill px-3">
            Ім'я @(currentSort == "name_asc" ? "↑" : currentSort == "name_desc" ? "↓" : "")
        </a>
        <a asp-action="Index" asp-route-sortOrder="@ViewData["AgeSort"]" asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-sm @(currentSort == "age_asc" || currentSort == "age_desc" ? "btn-info text-dark" : "btn-outline-secondary") rounded-pill px-3">
            Вік @(currentSort == "age_asc" ? "↑" : currentSort == "age_desc" ? "↓" : "")
        </a>
        <a asp-action="Index" asp-route-sortOrder="@ViewData["WeightSort"]" asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-sm @(currentSort == "weight_asc" || currentSort == "weight_desc" ? "btn-info text-dark" : "btn-outline-secondary") rounded-pill px-3">
            Вага @(currentSort == "weight_asc" ? "↑" : currentSort == "weight_desc" ? "↓" : "")
        </a>
        <a asp-action="Index" asp-route-sortOrder="@ViewData["GoalSort"]" asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-sm @(currentSort == "goal_asc" || currentSort == "goal_desc" ? "btn-info text-dark" : "btn-outline-secondary") rounded-pill px-3">
            Мета @(currentSort == "goal_asc" ? "↑" : currentSort == "goal_desc" ? "↓" : "")
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model) {
            <div class="col">
                <div class="card h-100 glass-card premium-hover">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@item.FullName</h5>
                        <p class="card-text text-muted mb-1"><i class="bi bi-calendar-event me-2"></i>Вік: @(item.Age?.ToString() ?? "Не вказано")</p>
                        <p class="card-text text-muted mb-1"><i class="bi bi-speedometer2 me-2"></i>Вага: @(item.WeightKg?.ToString() ?? "Не вказано") кг</p>
                        @if (!string.IsNullOrEmpty(item.Goal))
                        {
                            <p class="card-text"><span class="badge bg-info text-dark">Мета: @item.Goal</span></p>
                        }
                    </div>
                    <div class="card-footer bg-transparent border-0 d-flex justify-content-between pb-3">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light rounded-pill px-3">Редагувати</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill px-3">Деталі</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Видалити</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
