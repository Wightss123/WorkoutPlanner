@model WorkoutPlanner.Models.User

@{
    ViewData["Title"] = "Профіль клієнта";
}

<div class="container mt-4 fade-in">
    <!-- Шапка профілю -->
    <div class="card glass-card mb-4 border-0 shadow-sm" style="background: linear-gradient(135deg, rgba(44, 104, 123, 0.3), rgba(219, 26, 26, 0.1)); border-radius: 1rem;">
        <div class="card-body p-4 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-white mb-1">@Model.FullName</h2>
                <span class="badge rounded-pill bg-light text-dark fw-bold px-3 py-2 me-2">Вік: @Model.Age</span>
                <span class="badge rounded-pill bg-light text-dark fw-bold px-3 py-2 me-2">Вага: @Model.WeightKg кг</span>
                <span class="badge rounded-pill bg-info text-dark px-3 py-2 fw-bold shadow-sm">Мета: @Model.Goal</span>
            </div>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-light rounded-pill px-4">Редагувати</a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Рекомендація -->
        <div class="col-md-12">
            <div class="card shadow-sm border-0 position-relative overflow-hidden" style="background-color: rgba(255, 255, 255, 0.05); border-radius: 1rem; border-left: 5px solid var(--color-purple) !important;">
                <div class="card-body p-4 position-relative z-1 d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-white mb-3 d-flex align-items-center">
                            <span class="d-flex justify-content-center align-items-center rounded-circle me-3" style="width: 40px; height: 40px; background: rgba(140, 199, 196, 0.2);">
                                <i class="bi bi-bullseye" style="color: var(--color-purple);"></i>
                            </span>
                            Персональна порада
                        </h5>
                        <p class="mb-3 mb-md-0 text-light fs-5" style="line-height: 1.6;">@ViewBag.Recommendation</p>
                    </div>
                    <div class="ms-md-4 text-md-end shrink-0">
                        <a asp-controller="WorkoutLogs" asp-action="Create" asp-route-userId="@Model.Id" class="btn btn-light text-dark fw-bold rounded-pill px-4 py-2 shadow-sm" style="white-space: nowrap;">
                            <i class="bi bi-plus-circle me-2"></i>Додати тренування
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Графік калорій -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0 h-100" style="background-color: rgba(255,255,255,0.05); border-radius: 1rem;">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-white mb-4">🔥 Спалені калорії за типом</h5>
                    
                    @if (ViewBag.CardioCals == 0 && ViewBag.StrengthCals == 0 && ViewBag.FlexibilityCals == 0 && ViewBag.IntervalCals == 0)
                    {
                        <div class="text-muted mt-5">Немає даних для графіка.</div>
                    }
                    else
                    {
                        <canvas id="caloriesChart" style="max-height: 250px;"></canvas>
                    }
                </div>
            </div>
        </div>

        <!-- Історія тренувань -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0 h-100" style="background-color: rgba(255,255,255,0.05); border-radius: 1rem;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold text-white mb-0">🕒 Останні тренування</h5>
                    </div>

                    @if (!Model.WorkoutLogs.Any())
                    {
                        <p class="text-muted text-center py-4">Журнал порожній.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-borderless align-middle mb-0 text-white">
                                <thead>
                                    <tr class="text-muted border-bottom border-secondary">
                                        <th>Дата</th>
                                        <th>Назва</th>
                                        <th>Тип</th>
                                        <th>Калорії</th>
                                        <th>Коментар</th>
                                        <th class="text-end">Дії</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.WorkoutLogs.OrderByDescending(l => l.CompletedDate).Take(5))
                                    {
                                        <tr>
                                            <td>@log.CompletedDate.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <div class="fw-semibold">@log.Workout?.Name</div>
                                                @if (!string.IsNullOrEmpty(log.GetDetails()))
                                                {
                                                    <div class="text-muted small">@log.GetDetails()</div>
                                                }
                                            </td>
                                            <td>
                                                @if(log.WorkoutType == "Cardio") { <span class="badge bg-danger rounded-pill"><i class="bi bi-heart-pulse me-1"></i>Кардіо</span> }
                                                else if(log.WorkoutType == "Strength") { <span class="badge bg-warning text-dark rounded-pill"><i class="bi bi-lightning-charge me-1"></i>Силове</span> }
                                                else if(log.WorkoutType == "Interval") { <span class="badge bg-info text-dark rounded-pill"><i class="bi bi-stopwatch me-1"></i>Інтервальне</span> }
                                                else { <span class="badge bg-success rounded-pill"><i class="bi bi-activity me-1"></i>Гнучкість</span> }
                                            </td>
                                            <td class="text-warning">~@log.CalculateCaloriesBurned().ToString("F0") ккал</td>
                                            <td class="text-muted small">@(string.IsNullOrEmpty(log.Comment) ? "-" : $"\"{log.Comment}\"")</td>
                                            <td class="text-end">
                                                <form asp-controller="WorkoutLogs" asp-action="Delete" asp-route-id="@log.Id" method="post" class="d-inline" onsubmit="return confirm('Ви впевнені, що хочете видалити це тренування?');">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">Видалити</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Підключення бібліотеки Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var ctx = document.getElementById('caloriesChart');
            if(ctx) {
                var totalCalories = @(ViewBag.CardioCals + ViewBag.StrengthCals + ViewBag.FlexibilityCals + ViewBag.IntervalCals);
                
                const centerTextPlugin = {
                    id: 'centerText',
                    beforeDraw: function(chart) {
                        if (chart.config.type !== 'doughnut') return;
                        var ctx = chart.ctx;
                        var chartArea = chart.chartArea;
                        if (!chartArea) return;
                        
                        var centerX = chartArea.left + (chartArea.right - chartArea.left) / 2;
                        var centerY = chartArea.top + (chartArea.bottom - chartArea.top) / 2;
                
                        ctx.restore();
                        var fontSize = ((chartArea.bottom - chartArea.top) / 100).toFixed(2);
                        ctx.font = "bold " + fontSize + "em Outfit, sans-serif";
                        ctx.textBaseline = "middle";
                        ctx.textAlign = "center";
                        ctx.fillStyle = "#ffffff";
                
                        var text = totalCalories + " ккал";
                        ctx.fillText(text, centerX, centerY - 10);
                        
                        ctx.font = (fontSize * 0.4).toFixed(2) + "em Outfit, sans-serif";
                        ctx.fillStyle = "#adb5bd";
                        var labelText = "Всього";
                        ctx.fillText(labelText, centerX, centerY + 20);
                        ctx.save();
                    }
                };

                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Кардіо', 'Силове', 'Гнучкість', 'Інтервальне'],
                        datasets: [{
                            data: [
                                @ViewBag.CardioCals, 
                                @ViewBag.StrengthCals, 
                                @ViewBag.FlexibilityCals,
                                @ViewBag.IntervalCals
                            ],
                            backgroundColor: [
                                '#dc3545',
                                '#ffc107',
                                '#198754',
                                '#0dcaf0'
                            ],
                            borderWidth: 2,
                            borderColor: '#212529',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        cutout: '75%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { 
                                    color: '#fff',
                                    padding: 20,
                                    font: { family: 'Outfit', size: 14 }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        var value = context.raw;
                                        var percentage = Math.round((value / totalCalories) * 100);
                                        return ' ' + value + ' ккал (' + percentage + '%)';
                                    }
                                }
                            }
                        }
                    },
                    plugins: [centerTextPlugin]
                });
            }
        });
    </script>
}
