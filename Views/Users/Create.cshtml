@model WorkoutPlanner.Models.User

@{
    ViewData["Title"] = "Додати клієнта";
}

<div class="container mt-5 fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card glass-card">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4 fw-bold text-gradient">Новий клієнт</h2>
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="row g-3 mb-3">
                            <div class="col-md-6 form-floating">
                                <input asp-for="FirstName" class="form-control bg-dark text-light border-secondary" placeholder="Ім'я" />
                                <label asp-for="FirstName" class="text-muted ms-2">Ім'я</label>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 form-floating">
                                <input asp-for="LastName" class="form-control bg-dark text-light border-secondary" placeholder="Прізвище" />
                                <label asp-for="LastName" class="text-muted ms-2">Прізвище</label>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6 form-floating">
                                <input asp-for="Age" class="form-control bg-dark text-light border-secondary" placeholder="Вік" />
                                <label asp-for="Age" class="text-muted ms-2">Вік</label>
                                <span asp-validation-for="Age" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 form-floating">
                                <input asp-for="WeightKg" class="form-control bg-dark text-light border-secondary" placeholder="Вага (кг)" />
                                <label asp-for="WeightKg" class="text-muted ms-2">Вага (кг)</label>
                                <span asp-validation-for="WeightKg" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4 text-start">
                            <label asp-for="Goal" class="form-label text-muted fw-bold mb-1">Спортивна мета</label>
                            <select asp-for="Goal" class="form-select bg-dark text-light border-secondary" required>
                                <option value="">Оберіть мету...</option>
                                <option value="Схуднення / Жироспалювання">Схуднення / Жироспалювання</option>
                                <option value="Набір м'язової маси">Набір м'язової маси</option>
                                <option value="Підтримка форми / Тонус">Підтримка форми / Тонус</option>
                                <option value="Розвиток витривалості">Розвиток витривалості</option>
                                <option value="Покращення гнучкості та постави">Покращення гнучкості та постави</option>
                                <option value="Рельєф / Сушка">Рельєф / Сушка</option>
                                <option value="Відновлення / Реабілітація">Відновлення / Реабілітація</option>
                            </select>
                            <span asp-validation-for="Goal" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-glow rounded-pill py-3 fw-bold">Зберегти</button>
                            <button type="button" onclick="history.back()" class="btn btn-outline-light rounded-pill py-2">Скасувати</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
