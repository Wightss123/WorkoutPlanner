<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FitPlanner</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    
    <header>
        <nav>
            <div>
                <a asp-area="" asp-controller="Home" asp-action="Index">
                    <i></i>FitPlanner
                </a>
                <button type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span></span>
                </button>
                <div>
                    <ul>
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="Index">Головна</a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Users" asp-action="Index">Клієнти</a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Workouts" asp-action="Index">Тренування</a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="WorkoutLogs" asp-action="Index">Журнал</a>
                        </li>
                        <li>
                            <a href="#" data-bs-toggle="modal" data-bs-target="#aboutModal">Про застосунок</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>

    <!-- Модальне діалогове вікно "Про застосунок" -->
    <div id="aboutModal" tabindex="-1" aria-labelledby="aboutModalLabel" aria-hidden="true">
        <div>
            <div style="border-radius: 1rem;">
                <div>
                    <h5 id="aboutModalLabel">
                        <i></i>Про застосунок
                    </h5>
                    <button type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div>
                    <div>
                        <div style="width: 100px; height: 100px; font-size: 2.5rem;">
                            <i></i>
                        </div>
                    </div>
                    <h4>FitPlanner v1.0</h4>
                    <p>Система управління тренуваннями</p>
                    <hr />
                    <div>
                        <p><i></i><strong>Розробник:</strong> <span>Дмитро Митник</span></p>
                        <p><i></i><strong>Навчальний заклад:</strong> <span>ЧНУ ім. Б. Хмельницького</span></p>
                        <p><i></i><strong>Дисципліна:</strong> <span>Об'єктно-орієнтоване програмування</span></p>
                        <p><i></i><strong>Рік:</strong> <span>2026</span></p>
                    </div>
                    <hr />
                    <p>
                        Побудовано з використанням ASP.NET Core MVC, Entity Framework Core, SQLite та Bootstrap 5.
                    </p>
                </div>
                <div>
                    <button type="button" data-bs-dismiss="modal">Закрити</button>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <div>
            &copy; 2026 - FitPlanner - <a asp-area="" asp-controller="Home" asp-action="Privacy">Конфіденційність</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
